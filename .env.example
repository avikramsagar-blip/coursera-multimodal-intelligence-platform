# Copy this file to .env and fill in values for your environment.
# Production defaults should never be left blank.

# Core runtime
APP_ENV=production
BACKEND_PORT=8000

# PostgreSQL (primary production database)
# Examples:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/coursera
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.example.com:5432/coursera
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/coursera

# Local development fallback (optional, only for dev/test)
# DATABASE_URL=sqlite:///./dev.db

# JWT / auth
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
SECRET_KEY=${JWT_SECRET_KEY}

# AI providers
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Object storage
# Use OBJECT_STORAGE_PROVIDER=local for fully offline / development use.
# Files are saved to backend/uploads (or LOCAL_UPLOAD_DIR if set).
# Use OBJECT_STORAGE_PROVIDER=s3 for production and fill in the AWS vars below.
OBJECT_STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=

# S3-compatible settings (only required when OBJECT_STORAGE_PROVIDER=s3)
OBJECT_STORAGE_BUCKET=coursera-uploads
AWS_S3_BUCKET=coursera-uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
AWS_S3_PUBLIC_URL=
OBJECT_STORAGE_PUBLIC_URL=

# Cloudinary (kept optional for legacy compatibility)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vector database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=course

# CORS / security
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.example.com
MAX_REQUEST_SIZE_BYTES=10485760
MAX_UPLOAD_SIZE_BYTES=52428800

# Logging / security headers
ENABLE_SECURITY_HEADERS=true

# Demo seeding (do NOT enable for production)
SEED_DEMO=false
