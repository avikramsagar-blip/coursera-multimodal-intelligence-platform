# Copy this file to .env and fill in values for your environment
# Development defaults are provided where appropriate.

# JWT secret used to sign access tokens
SECRET_KEY=your_secret_key_here

# Database URL. For quick local setup use SQLite:
# DATABASE_URL=sqlite:///./dev.db
DATABASE_URL=sqlite:///./dev.db

# Gemini / Google GenAI API key for embeddings and LLM (optional for local dev)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Cloudinary credentials (optional; if provided, media will be uploaded to Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional settings
# Port for backend
BACKEND_PORT=8000

# Toggle demo seeding (do NOT enable for production)
SEED_DEMO=false
